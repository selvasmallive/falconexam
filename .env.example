# FalconExam local development configuration.
#
#   cp .env.example .env
#
# Copy this file to .env and adjust ports if they clash with something already running.
# .env is git-ignored and must never be committed.
#
# LOCAL DEVELOPMENT ONLY. Every value here is a throwaway local credential. Real environments read
# secrets from Google Secret Manager at runtime — never from a checked-in file, and never from an
# image. If you find yourself putting a real credential in this file, stop.

# --- PostgreSQL ---
POSTGRES_USER=falconexam
POSTGRES_PASSWORD=falconexam_local_dev
POSTGRES_DB=falconexam
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Cloud Storage emulator ---
STORAGE_PORT=4443
STORAGE_BUCKET_MEDIA=falconexam-local-media
STORAGE_EMULATOR_HOST=http://localhost:4443

# --- Mail catcher (Mailpit) ---
MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025

# --- Application ports (services arrive in Milestone 1) ---
API_PORT=8080
AI_PORT=8000
WEB_PORT=5173
